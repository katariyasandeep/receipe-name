{
  "name": "@sandeep_saini/recipe-ui",
  "version": "0.1.0",
  "description": "Reusable StencilJS web components for Recipe Finder & Meal Planner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeepsaini01/recipe-finder.git",
    "directory": "packages/recipe-ui"
  },
  "homepage": "https://github.com/sandeepsaini01/recipe-finder#readme",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/recipe-ui/recipe-ui.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/recipe-ui/recipe-ui.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "files": [
    "dist/",
    "loader/",
    "README.md"
  ],
  "sideEffects": [
    "./loader/**",
    "./dist/recipe-ui/**",
    "./dist/components/**",
    "*.css"
  ],
  "scripts": {
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --coverage",
    "test.watch": "stencil test --spec --watchAll",
    "generate": "stencil generate",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "stencil",
    "web-components",
    "recipe",
    "meal-planner",
    "ui"
  ],
  "devDependencies": {
    "@stencil/core": "^4.22.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0"
  }
}
