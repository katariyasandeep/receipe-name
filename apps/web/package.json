{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "description": "SvelteKit Recipe Finder app",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
